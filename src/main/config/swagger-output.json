{
  "openapi": "3.0.3",
  "info": {
    "title": "PokéManager API — Entrega 2",
    "version": "2.0.0",
    "description": "Catálogo local, treinadores, equipes e integração com PokéAPI"
  },
  "servers": [
    {
      "url": "http://localhost:3333"
    }
  ],
  "paths": {
    "/api/v1/pokemons": {
      "get": {
        "summary": "Listar o catálogo local",
        "tags": [
          "Pokemons"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Cadastrar no catálogo local",
        "tags": [
          "Pokemons"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "hp",
                  "attack",
                  "defense"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "hp": {
                    "type": "integer"
                  },
                  "attack": {
                    "type": "integer"
                  },
                  "defense": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "summary": "Buscar no catálogo por ID",
        "tags": [
          "Pokemons"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "summary": "Atualizar dados locais",
        "tags": [
          "Pokemons"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "hp",
                  "attack",
                  "defense"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "hp": {
                    "type": "integer"
                  },
                  "attack": {
                    "type": "integer"
                  },
                  "defense": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Excluir do catálogo",
        "tags": [
          "Pokemons"
        ],
        "responses": {
          "204": {
            "description": "Excluído"
          },
          "404": {
            "description": "Não encontrado"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/pokedex/search": {
      "get": {
        "summary": "Consultar dados oficiais na PokéAPI",
        "tags": [
          "Pokedex"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "pikachu"
          }
        ]
      }
    },
    "/api/v1/trainers": {
      "post": {
        "summary": "Cadastrar treinador",
        "tags": [
          "Trainers"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/captures": {
      "post": {
        "summary": "Capturar Pokémon (máximo seis no time)",
        "tags": [
          "Trainers"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "trainerId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{trainerId}/team": {
      "get": {
        "summary": "Listar time ativo",
        "tags": [
          "Trainers"
        ],
        "responses": {
          "200": {
            "description": "Sucesso"
          },
          "201": {
            "description": "Criado"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "404": {
            "description": "Não encontrado"
          },
          "409": {
            "description": "Conflito"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "trainerId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  }
}
